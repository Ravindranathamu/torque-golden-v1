# --- WhatsApp Cloud API (Meta) ---
# Permanent token from a Meta system user with whatsapp_business_messaging
WHATSAPP_TOKEN=
# Numeric phone number ID from WhatsApp Business → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Random string you also paste into the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta → App settings → Basic (enables signature checks)
WHATSAPP_APP_SECRET=
# Graph API version
GRAPH_VERSION=v21.0

# --- Gateway security ---
# Long random key. The browser/PWA sends it as Authorization: Bearer <key>.
GATEWAY_API_KEY=
# Comma-separated origins allowed to call the gateway, e.g. https://erp.example.com
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
PORT=8787
