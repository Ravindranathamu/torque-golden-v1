# --- Demo / local development ---
# The app runs entirely on localStorage when no Supabase keys are present.
# Leave these blank to explore the demo workshop.

# For a PUBLIC demo deployment only. When set, the whole demo build locks after
# this UTC date/time, even if a visitor clears browser storage. Leave blank for
# normal client and local builds.
# Example: 2026-12-31T23:59:59Z
VITE_DEMO_EXPIRES_AT=

# --- Supabase (production backend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Storage bucket names (must match supabase/migrations/20261114000100_schema.sql)
VITE_SUPABASE_JOB_PHOTOS_BUCKET=job-photos
VITE_SUPABASE_BRANDING_BUCKET=branding

# --- WhatsApp gateway ---
# Base URL of server/whatsapp-gateway (leave blank to use wa.me deep links only)
VITE_WHATSAPP_GATEWAY_URL=
# Shared secret matching GATEWAY_API_KEY on the gateway. Never use a service-role key here.
VITE_WHATSAPP_GATEWAY_KEY=

# --- Google Drive (optional production integration) ---
# OAuth client ID used for Google Picker / Drive folder creation.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=

# --- Master developer portal & licence sync ---
# Supabase URL of the developer portal project. When blank the workshop runs
# fully offline and licenses are activated with local keys or TRQ2 tokens.
VITE_MASTER_LICENSE_URL=
# Public anon key of the developer portal project. Only the poll RPC and the
# portal tables are exposed; never use a service-role key in the browser.
VITE_MASTER_LICENSE_ANON_KEY=
# Optional signing secret override for offline TRQ2 activation tokens.
# Leave blank to use the built-in demo secret. Every workshop and the portal
# must share the same value for tokens to verify.
VITE_LICENSE_SIGNING_KEY=
# Reserved for a production asymmetric verifier (ECDSA public key). The demo
# build verifies TRQ2 tokens with the shared signing key above.
VITE_LICENSE_PUBLIC_KEY=
